@startuml use-case
' Use case diagram (DOA-10).
' Actors match the system context diagram (DOA-9). Use case IDs (UC-xx) are
' mapped to requirement IDs in docs/architecture/use-cases.md.
!include style.iuml
left to right direction
title Use Case Diagram

actor "Applicant" as APP
actor "Participant" as PAR
actor "Intervention-arm\nparticipant" as IA
actor "Control-arm\nparticipant" as CA

APP <|-- PAR
PAR <|-- IA
PAR <|-- CA

actor "Research\nadministrator" as RA
actor "Rule\nmaintainer" as RM
actor "Health Connect /\nHealthKit" as HEALTH <<system>>
actor "AI service" as AI <<system>>

rectangle "Weight Management Recommender System" {

  package "Onboarding" {
    usecase "UC-01 Register and sign in" as UC01
    usecase "UC-02 Give informed consent" as UC02
    usecase "UC-03 Complete eligibility\nscreening" as UC03
    usecase "UC-04 Receive referral\nto clinical care" as UC04
    usecase "UC-05 Choose interface\nlanguage" as UC05
    usecase "UC-06 Be assigned to\na study arm" as UC06
  }

  package "Self-monitoring (both arms)" {
    usecase "UC-07 Manage profile" as UC07
    usecase "UC-08 Log food" as UC08
    usecase "UC-09 Log food with\nAI assistance" as UC09
    usecase "UC-10 Add custom food" as UC10
    usecase "UC-11 Log weight and waist" as UC11
    usecase "UC-12 Synchronize steps\nand heart rate" as UC12
    usecase "UC-13 View progress" as UC13
    usecase "UC-14 Complete weekly\nsafety check-in" as UC14
    usecase "UC-15 Answer study\nquestionnaire" as UC15
    usecase "UC-16 Withdraw from study" as UC16
  }

  package "Recommendations (intervention arm)" {
    usecase "UC-17 View ranked\nlifestyle factors" as UC17
    usecase "UC-18 View recommendations" as UC18
    usecase "UC-19 View explanation\n(“Why?”)" as UC19
    usecase "UC-20 Receive activity prompt" as UC20
    usecase "UC-21 Set active hours\nand mute prompts" as UC21
  }

  package "Study administration" {
    usecase "UC-22 Manage enrollment" as UC22
    usecase "UC-23 Record study\nmeasurements" as UC23
    usecase "UC-24 Review adverse events\nand deletion requests" as UC24
    usecase "UC-25 Export pseudonymized\ndata" as UC25
    usecase "UC-26 Switch AI food\nlogging on or off" as UC26
  }

  package "Rule base" {
    usecase "UC-27 Maintain versioned\nrule base" as UC27
    usecase "UC-28 Run batch verification\non synthetic profiles" as UC28
  }
}

' Applicant
APP --> UC01
APP --> UC03
APP --> UC05
UC03 ..> UC02 : <<include>>
UC03 <.. UC04 : <<extend>>\n[not eligible]
UC03 <.. UC06 : <<extend>>\n[eligible]

' Participant (both arms)
PAR --> UC07
PAR --> UC08
PAR --> UC11
PAR --> UC12
PAR --> UC13
PAR --> UC14
PAR --> UC15
PAR --> UC16
UC08 <.. UC09 : <<extend>>
UC08 <.. UC10 : <<extend>>
UC14 ..> UC04 : <<extend>>\n[adverse event]

' Intervention arm only
IA --> UC17
IA --> UC18
IA --> UC20
IA --> UC21
UC18 <.. UC19 : <<extend>>

' Research administrator
UC22 <-- RA
UC23 <-- RA
UC24 <-- RA
UC25 <-- RA
UC26 <-- RA

' Rule maintainer
UC27 <-- RM
UC28 <-- RM

' Secondary (system) actors
UC12 --> HEALTH
UC09 --> AI

note "Control-arm participants use only the\nOnboarding and Self-monitoring use cases\n(self-monitoring mode, FR-31)." as N1
CA .. N1
@enduml
