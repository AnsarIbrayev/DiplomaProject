# Configuration example with placeholder values only.
# Copy to .env and fill in local values. Never commit .env.
# The backend (FastAPI, DOA-17) is not implemented yet; names may change.

# Backend
APP_ENV=development
API_BASE_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/weight_assistant

# Authentication
JWT_SECRET=change_me
JWT_EXPIRES_MINUTES=60

# AI-assisted food logging (FR-40), optional; leave empty to switch the feature off
AI_PROVIDER=
AI_API_KEY=
